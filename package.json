{
  "name": "agent-commander",
  "version": "0.1.0",
  "description": "Sovereign supervisory control plane for third-party agents: step-gated airlock, mechanical proof auditing, MCP gateway.",
  "private": true,
  "type": "module",
  "bin": { "commander-guard": "dist/guard/claude-hook.js" },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "guard:settings": "tsx src/guard/claude-hook.ts --print-settings"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
