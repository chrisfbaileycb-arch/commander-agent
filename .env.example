# Agent Commander — environment. Copy to .env and fill in. Nothing here is a real secret.

# Listener
HOST=127.0.0.1
PORT=8787

# Public base URL used in approval links and push cards. Must be reachable from the operator's phone.
COMMANDER_PUBLIC_URL=https://commander.example.com

# Persistence. Leave unset for an in-memory (ephemeral) instance.
COMMANDER_DATA_DIR=./data

# Secret that signs approval links (openssl rand -hex 32). If unset, links die on every restart.
COMMANDER_LINK_SECRET=change-me

# Platform admin token for tenant provisioning (openssl rand -hex 24). If unset, /v1/admin/* is disabled.
COMMANDER_ADMIN_TOKEN=change-me

# Push channel for staged approvals. Receives an ntfy-shaped JSON card (title, message, click, http actions).
# If unset, cards are printed to stdout.
COMMANDER_NOTIFY_WEBHOOK=
COMMANDER_NOTIFY_TOPIC=

# Optional Frontier Reasoning Interceptor Gate (Gemini). Reviews elevated/critical-step actions that the rules
# allowed, and may tighten the verdict but never loosen it. Unset = deterministic rules only.
GEMINI_API_KEY=
# The model id is deployment configuration. The default is a placeholder: set the model you actually use.
COMMANDER_GEMINI_MODEL=gemini-2.5-flash

# Optional policy overrides (see policy.example.json).
COMMANDER_POLICY_FILE=
